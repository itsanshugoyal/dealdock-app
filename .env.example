# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://dealdock:dealdock@localhost:5432/dealdock

# ── Redis / queues ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (Clerk) ───────────────────────────────────────────
# Real keys go in .env (gitignored) — never here; this file is committed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Auth is ON by default and fails closed. Set this to "true" ONLY for keyless
# local dev / demo (never in a real deploy). NOT a NEXT_PUBLIC_ var by design.
DEALDOCK_DISABLE_AUTH=
# Required together with DEALDOCK_DISABLE_AUTH. This must be the one seeded
# local org id; an arbitrary x-demo-org header is never accepted.
DEALDOCK_DEV_ORG_ID=
# Server-only, local integration bridge. Loopback API only; never deployed.
DEALDOCK_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEALDOCK_DEMO_MODE=false

# ── AI (API and worker) ────────────────────────────────────
# Development: AI_PROVIDER=groq. Production: AI_PROVIDER=openai with
# AI_FALLBACK_PROVIDER=groq, which answers only when an OpenAI call fails.
# Both providers then receive creator messages: name both in the privacy policy.
AI_PROVIDER=groq
AI_FALLBACK_PROVIDER=
GROQ_API_KEY=
GROQ_CLASSIFY_MODEL=openai/gpt-oss-120b
GROQ_DRAFT_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_CLASSIFY_MODEL=gpt-6-luna
OPENAI_DRAFT_MODEL=gpt-6-luna
# none | low | medium | high | xhigh | max (default high). High: ~2s per classification, ~5.5s per draft.
OPENAI_REASONING_EFFORT=high
# To use Anthropic instead, set AI_PROVIDER=anthropic and configure all three:
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=
DRAFT_MODEL=
# Explicit non-production fallback only. Production requires a real configured provider.
DEALDOCK_AI_MODE=

# ── Instagram / Meta Graph API ─────────────────────────────
# Meta apps created after ~October 2026 only offer "Instagram API with Unified
# login" (Facebook Login for Business). For those: META_UNIFIED_LOGIN_ENABLED=true,
# META_APP_ID / META_APP_SECRET = the Meta app's App ID and App secret (App
# settings → Basic), META_LOGIN_CONFIG_ID = the login configuration's id (not a
# secret; its permissions replace scopes). Older Instagram Login apps: leave the
# flag off and use the Instagram app ID/secret. IG_OAUTH_REDIRECT_URI must match
# the redirect URL registered in Meta (https://<api-host>/ig/callback).
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
IG_OAUTH_REDIRECT_URI=
META_UNIFIED_LOGIN_ENABLED=false
META_LOGIN_CONFIG_ID=
WEB_APP_URL=http://localhost:3000

# ── Email channel: Gmail (API ONLY — see docs/email-channel.md) ──
# Google Cloud OAuth client (type "Web application"). Unset = email is off and
# its routes answer 409 email_not_configured. The redirect URI is the API's
# https://<api-host>/email/callback (plain http only for localhost outside production).
# gmail.readonly + gmail.send are RESTRICTED scopes: production needs Google's
# OAuth verification (including a security assessment). Until then the
# consent screen stays in "Testing" mode, where up to 100 listed test users can connect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional near-real-time sync through Gmail push (Cloud Pub/Sub). Both set =
# push on, plus a 15-minute safety poll; unset = every inbox is polled every 2 minutes.
# Topic "projects/<project>/topics/<topic>" must grant gmail-api-push@system.gserviceaccount.com
# the Pub/Sub Publisher role. Its push subscription's endpoint is
# https://<api-host>/webhooks/gmail?token=<GMAIL_PUBSUB_VERIFICATION_TOKEN> (24+ random characters).
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=

# ── Billing rail 1: Razorpay (INR orgs — UPI Autopay) ──────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_SOLO=
RAZORPAY_PLAN_STUDIO=
RAZORPAY_PLAN_ROSTER=

# ── Billing rail 2: Paddle (merchant of record, non-INR) ───
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_SOLO=
PADDLE_PRICE_STUDIO=
PADDLE_PRICE_ROSTER=
# Web app: Paddle.js on /pay, the account's default payment link. Token from
# `node scripts/paddle-setup.mjs` (or Paddle > Developer tools > Authentication).
# NEXT_PUBLIC_PADDLE_ENV must match PADDLE_ENV ("sandbox" or "live").
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_ENV=sandbox

# ── Web Push (VAPID — generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Optional: one high-value push bar for every account, in minor units. Unset =
# each account's lowest active brand offer, else its currency default.
# HIGH_VALUE_NOTIFY_MIN_MINOR=

# ── App-layer crypto (IG + Gmail token encryption, AES-256-GCM) ──
TOKEN_ENCRYPTION_KEY=
# API ONLY: never copy this file wholesale into worker environment variables.
# Worker rejects Meta/Google/encryption credentials at startup.

# Messaging provider is stored per connected account. OAuth creates Instagram
# accounts; the local seed creates an explicit mock account. No env fallback.

# ── Mock webhook shared secret (non-prod fixture injection; unset = disabled) ─
MOCK_WEBHOOK_SECRET=

# ── Feature flags (API; registry: packages/core/src/feature-flags.ts) ──
# Exactly "true" or "false"; anything else keeps the flag's default. The web
# reads them from the API, never from its own env. The META_* flags below are
# registry flags too.
# Invoices (billing details, invoice PDFs, invoice cover notes). Default on; set
# "false" in production until a chartered accountant signs off.
FEATURE_INVOICES_ENABLED=true

# ── Instagram reply window ─────────────────────────────────
# Set "true" ONLY after Meta approves the HUMAN_AGENT message tag for this app:
# human-approved replies may then be sent 24h–7d after the last inbound DM.
META_HUMAN_AGENT_ENABLED=false

# ── Comment leads (API) ────────────────────────────────────
# Set "true" ONLY after Meta App Review grants instagram_business_manage_comments
# (Advanced Access, with Business Verification; comment webhooks also need the app
# in Live mode). On: Instagram connections ask for that permission, accounts are
# subscribed to the `comments` webhook field, keyword comments become leads with a
# drafted private reply, and the web app shows them. Each reply is still approved
# and sent by a person. Accounts connected before turning it on reconnect once.
META_COMMENTS_ENABLED=false

# ── Post results (API) ─────────────────────────────────────
# Set "true" ONLY after Meta App Review grants instagram_business_manage_insights.
# On: Instagram connections ask for that permission and the deal's "Posts and
# results" sheet offers "Fetch from Instagram" (reels and feed posts; stories are
# typed in). Off: creators type the numbers from Instagram's insights. Accounts
# connected before turning it on reconnect once. The worker never reads insights.
META_INSIGHTS_ENABLED=false

# ── Speech: voice-note transcription + creator voice cloning (API + worker)
# elevenlabs | self_hosted | mock (mock is refused in production). Unset = off.
SPEECH_PROVIDER=
ELEVENLABS_API_KEY=
# Optional India data residency: https://api.in.residency.elevenlabs.io
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
# OpenAI-compatible server in front of an open model (e.g. Chatterbox Multilingual).
SELF_HOSTED_SPEECH_URL=
SELF_HOSTED_SPEECH_API_KEY=
# Voice-library upload route (not part of OpenAI's API; DELETE goes to <path>/<voice>).
# travisvn/chatterbox-tts-api serves it at /voices. Hindi needs the server to load
# the ResembleAI/Chatterbox-Multilingual-hi checkpoint.
SELF_HOSTED_SPEECH_VOICE_UPLOAD_PATH=/v1/voices
# "model" sent to /v1/audio/speech (Chatterbox servers ignore it).
SELF_HOSTED_SPEECH_TTS_MODEL=chatterbox
# Model id for /v1/audio/transcriptions (e.g. a faster-whisper server behind the same URL).
SELF_HOSTED_SPEECH_STT_MODEL=whisper-1

# ── Media links (API ONLY) ─────────────────────────────────
# HMAC key (>=32 chars) for signed /media/a/:id links; required in production.
MEDIA_SIGNING_KEY=
# Public https origin of the API — Meta fetches voice-note audio from here.
PUBLIC_API_URL=
