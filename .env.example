# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://dealdock:dealdock@localhost:5432/dealdock

# ── Redis / queues ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (Clerk) ───────────────────────────────────────────
# Real keys go in .env (gitignored) — never here; this file is committed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Auth is ON by default and fails closed. Set this to "true" ONLY for keyless
# local dev / demo (never in a real deploy). NOT a NEXT_PUBLIC_ var by design.
DEALDOCK_DISABLE_AUTH=
# Required together with DEALDOCK_DISABLE_AUTH. This must be the one seeded
# local org id; an arbitrary x-demo-org header is never accepted.
DEALDOCK_DEV_ORG_ID=
# Server-only, local integration bridge. Loopback API only; never deployed.
DEALDOCK_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_DEALDOCK_DEMO_MODE=false

# ── AI (Anthropic Claude) ──────────────────────────────────
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=
DRAFT_MODEL=
# Explicit non-production fallback only. Production always requires Claude.
DEALDOCK_AI_MODE=

# ── Instagram / Meta Graph API ─────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
IG_OAUTH_REDIRECT_URI=
WEB_APP_URL=http://localhost:3100

# ── Billing rail 1: Razorpay (INR orgs — UPI Autopay) ──────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_SOLO=
RAZORPAY_PLAN_STUDIO=
RAZORPAY_PLAN_ROSTER=

# ── Billing rail 2: Paddle (merchant of record, non-INR) ───
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_SOLO=
PADDLE_PRICE_STUDIO=
PADDLE_PRICE_ROSTER=

# ── Web Push (VAPID — generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Optional: one high-value push bar for every account, in minor units. Unset =
# each account's lowest active brand offer, else its currency default.
# HIGH_VALUE_NOTIFY_MIN_MINOR=

# ── App-layer crypto (IG token encryption, AES-256-GCM) ────
TOKEN_ENCRYPTION_KEY=
# API ONLY: never copy this file wholesale into worker environment variables.
# Worker rejects Meta/encryption credentials at startup.

# Messaging provider is stored per connected account. OAuth creates Instagram
# accounts; the local seed creates an explicit mock account. No env fallback.

# ── Mock webhook shared secret (non-prod fixture injection; unset = disabled) ─
MOCK_WEBHOOK_SECRET=

# ── Instagram reply window ─────────────────────────────────
# Set "true" ONLY after Meta approves the HUMAN_AGENT message tag for this app:
# human-approved replies may then be sent 24h–7d after the last inbound DM.
META_HUMAN_AGENT_ENABLED=false

# ── Speech: voice-note transcription + creator voice cloning (API + worker)
# elevenlabs | self_hosted | mock (mock is refused in production). Unset = off.
SPEECH_PROVIDER=
ELEVENLABS_API_KEY=
# Optional India data residency: https://api.in.residency.elevenlabs.io
ELEVENLABS_BASE_URL=https://api.elevenlabs.io
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v2
# OpenAI-compatible server in front of an open model (e.g. Chatterbox Multilingual).
SELF_HOSTED_SPEECH_URL=
SELF_HOSTED_SPEECH_API_KEY=
# Voice-library upload route (not part of OpenAI's API; DELETE goes to <path>/<voice>).
# travisvn/chatterbox-tts-api serves it at /voices. Hindi needs the server to load
# the ResembleAI/Chatterbox-Multilingual-hi checkpoint.
SELF_HOSTED_SPEECH_VOICE_UPLOAD_PATH=/v1/voices
# "model" sent to /v1/audio/speech (Chatterbox servers ignore it).
SELF_HOSTED_SPEECH_TTS_MODEL=chatterbox
# Model id for /v1/audio/transcriptions (e.g. a faster-whisper server behind the same URL).
SELF_HOSTED_SPEECH_STT_MODEL=whisper-1

# ── Media links (API ONLY) ─────────────────────────────────
# HMAC key (>=32 chars) for signed /media/a/:id links; required in production.
MEDIA_SIGNING_KEY=
# Public https origin of the API — Meta fetches voice-note audio from here.
PUBLIC_API_URL=
