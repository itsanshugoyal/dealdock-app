# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://dealdock:dealdock@localhost:5432/dealdock

# ── Redis / queues ─────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Auth (Clerk) ───────────────────────────────────────────
# Real keys go in .env (gitignored) — never here; this file is committed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── AI (Anthropic Claude) ──────────────────────────────────
ANTHROPIC_API_KEY=

# ── Instagram / Meta Graph API ─────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
IG_OAUTH_REDIRECT_URI=https://api.dealdock.in/ig/callback
WEB_APP_URL=http://localhost:3100

# ── Billing rail 1: Razorpay (INR orgs — UPI Autopay) ──────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_SOLO=
RAZORPAY_PLAN_STUDIO=
RAZORPAY_PLAN_ROSTER=

# ── Billing rail 2: Paddle (merchant of record, non-INR) ───
PADDLE_ENV=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_SOLO=
PADDLE_PRICE_STUDIO=
PADDLE_PRICE_ROSTER=

# ── Web Push (VAPID — generate once: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
HIGH_VALUE_NOTIFY_MIN_MINOR=5000000

# ── App-layer crypto (IG token encryption, AES-256-GCM) ────
TOKEN_ENCRYPTION_KEY=

# ── Messaging provider per environment: mock | instagram ───
DEFAULT_MESSAGING_PROVIDER=mock
