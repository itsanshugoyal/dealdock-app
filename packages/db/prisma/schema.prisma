// DealDock data model — implements ARCHITECTURE.md §3 (PRD v1.1).
// Money: integer minor units, org-level currency (ADR-9). Tenancy: every
// query goes through the org-scoped repository layer in src/repos (ADR-7).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────

enum Tier {
  solo
  studio
  roster
}

enum SeatRole {
  creator
  assistant
  manager
}

enum IgAccountStatus {
  active
  disconnected
  token_expired
}

enum Platform {
  instagram
  whatsapp
  email
}

enum MessagingProviderKind {
  mock
  instagram_graph
  gmail
}

enum ThreadState {
  open
  waiting
  closed
}

enum MessageDirection {
  inbound
  outbound
}

enum ContentType {
  text
  audio
  attachment
}

enum ClassificationLabel {
  brand_deal
  coaching_lead
  course_inquiry
  other_commerce
  fan
  spam
  personal
  uncertain
}

enum MessageLanguage {
  en
  hi
  hinglish
  mixed
}

enum RoutedTo {
  inbox
  review_queue
}

enum ReviewOutcome {
  confirmed
  overridden
}

enum ClassificationSource {
  live
  leak_scan
}

enum DraftStatus {
  ready
  edited
  sending // claimed by an in-flight send — the double-send lock (M5 audit)
  sent
  discarded
}

enum DraftKind {
  reply
  nudge
}

enum DealType {
  brand
  coaching
  course
  other
}

// Where an agreed deal is on its way to the money. "Overdue" is derived (open and past dueAt).
enum DealStage {
  agreed
  invoiced
  paid
  cancelled
}

// "full" bills the whole fee; "advance" the agreed upfront share; "balance" what is left.
enum InvoiceKind {
  full
  advance
  balance
}

// A voided invoice keeps its number: numbers are never reused.
enum InvoiceStatus {
  issued
  paid
  void
}

// How tax applies: GST within India (or VAT), India export under LUT (no IGST) or with IGST, or untaxed.
enum SupplyType {
  domestic
  export_lut
  export_tax
  untaxed
}

// Coach pipeline: where a coaching or course lead stands. A thread with no stage
// that is labelled coaching_lead or course_inquiry shows as a lead.
enum LeadStage {
  lead
  qualified
  booked
  paid
}

// Booking and payment tools that report back to the coach pipeline. "other"
// is a plain JSON webhook (Zapier, Make, Topmate through an automation).
enum LeadSourceProvider {
  calendly
  cal_com
  razorpay
  stripe
  other
}

enum LeadEventKind {
  booked
  paid
}

// A keyword comment's private reply: drafted, then approved and sent once, or skipped.
// "Expired" is derived: Instagram allows a private reply for 7 days after the comment.
enum CommentLeadStatus {
  new
  sending
  sent
  skipped
}

enum SubscriptionStatus {
  pending_first_invoice
  active
  past_due
  cancelled
}

enum BillingRail {
  razorpay
  paddle
}

enum SendIntentStatus {
  pending
  remote_accepted
  persisted
  unknown
}

// Provenance of an outbound message (research 04 §3). Only human-authored
// text is style evidence; untouched DealDock drafts never feed learning.
enum MessageOrigin {
  native     // typed in Instagram by the account (echo without a DealDock SendIntent, or history import)
  dealdock   // sent through DealDock's human send gate
  automation // third-party sender (echo app_id ≠ ours) or detected template blast
}

enum VoiceRuleStatus {
  candidate // evidence accruing, never used in prompts
  active    // used in prompts
  pinned    // user-confirmed; never auto-demoted
  muted     // user said "not me"; never used, never re-proposed
}

enum VoiceRuleSource {
  samples  // initial corpus analysis
  edits    // distilled from edit diffs
  feedback // quick chips / regenerate instructions
  user     // typed by the user in Voice Studio
}

enum SpeakingVoiceStatus {
  pending
  ready
  failed
  revoked
}

enum AudioAssetKind {
  voice_sample // in-app recorded cloning sample
  consent      // the spoken consent statement
  tts          // generated reply in the cloned voice
  inbound      // voice note received from a sender
}

// ── Tenancy root ─────────────────────────────────────────────────────────

model Organization {
  id             String   @id @default(cuid())
  name           String
  tier           Tier     @default(solo)
  pilotCohort    Boolean  @default(true)
  pricingLockedAt DateTime?

  // Region (PRD §6.1, ADR-9) — one currency per org.
  currencyCode  String @default("INR") // ISO 4217: INR | USD | GBP | EUR | AED
  locale        String @default("en-IN")
  timezone      String @default("Asia/Kolkata")
  nudgeDelayDays Int   @default(3)

  // Onboarding questionnaire (PRD §5.1.5): businessSummary + typical deal-size
  // ranges in org-currency minor units — feeds value estimation (§6.2).
  businessContext Json?

  // Account deletion: 7-day grace, then the retention job hard-deletes (PRD §6.11).
  deletionRequestedAt DateTime?

  // Monthly confirmed-revenue goal in org-currency minor units (Insights).
  monthlyGoalMinor BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats            Seat[]
  igAccounts       IgAccount[]
  ignoreList       IgnoreListEntry[]
  auditLogs        AuditLog[]
  subscription     Subscription?
  webhookScopes    WebhookEventOrg[]
  outboxEvents     OutboxEvent[]
  billingEvents    BillingEventReceipt[]
  voiceRules       VoiceRule[]
  draftFeedback    DraftFeedback[]
  offers           Offer[]
  speakingVoices   SpeakingVoice[]
  audioAssets      AudioAsset[]
  billingProfiles  BillingProfile[]
  leadSources      LeadSource[]
}

model User {
  id          String @id @default(cuid())
  clerkUserId String @unique
  email       String
  name        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats Seat[]
}

model Seat {
  id     String   @id @default(cuid())
  orgId  String
  userId String
  role   SeatRole

  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  sentDrafts     Draft[]         @relation("SentBy")
  ledgerEntries  LedgerEntry[]
  deals          Deal[]
  invoices       Invoice[]
  reviews        Classification[] @relation("ReviewedBy")
  auditLogs      AuditLog[]
  pushSubs       PushSubscription[]
  draftFeedback  DraftFeedback[]
  speakingVoiceConsents SpeakingVoice[] @relation("SpeakingVoiceConsent")

  @@unique([orgId, userId])
  @@index([orgId])
}

// ── Instagram connection ─────────────────────────────────────────────────

model IgAccount {
  id             String          @id @default(cuid())
  orgId          String
  platform       Platform        @default(instagram)
  provider       MessagingProviderKind @default(mock)
  igUserId       String
  handle         String
  accountType    String // "business" | "creator" — personal rejected at connect (PRD §6.1)
  // AES-256-GCM encrypted at the application layer (ARCHITECTURE.md §8).
  accessTokenEnc String?
  // Providers with long-lived refresh tokens (Gmail). Same AES-256-GCM envelope.
  refreshTokenEnc String?
  // Channel inboxes (Gmail) belong to one creator account, so their threads, deals and money count for that creator.
  ownerAccountId  String?
  tokenRefreshedAt DateTime?
  tokenExpiresAt DateTime?
  status         IgAccountStatus @default(active)
  connectedAt    DateTime        @default(now())
  disconnectedAt DateTime?

  // Onboarding Leak Scan (PRD §5.1.6) progress for the reveal: when the last
  // scan was queued, and when it had queued all of its history (null while
  // it runs). Classification can still be catching up after completion.
  leakScanStartedAt   DateTime?
  leakScanCompletedAt DateTime?

  // The private rate-card link (/rates/<token>); null = no link. Rotating it ends the old link.
  rateCardToken   String?  @unique
  // Comment words that make a commenter a lead ("PRICE", "LINK"), matched case-insensitively.
  commentKeywords String[] @default([])

  org        Organization         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner      IgAccount?           @relation("ChannelOwner", fields: [ownerAccountId], references: [id], onDelete: SetNull)
  channelAccounts IgAccount[]     @relation("ChannelOwner")
  threads    Thread[]
  voice      VoiceProfile?
  checkpoint IngestionCheckpoint?
  ignoreList IgnoreListEntry[]
  voiceRules VoiceRule[]
  offers     Offer[]
  speakingVoice SpeakingVoice?
  billingProfile BillingProfile?
  deals         Deal[]
  ledgerEntries LedgerEntry[]
  commentLeads  CommentLead[]

  @@unique([platform, igUserId])
  @@index([orgId])
}

// ── Threads & messages ───────────────────────────────────────────────────

model Thread {
  id                   String      @id @default(cuid())
  orgId                String
  igAccountId          String
  igThreadId           String
  participantHandle    String
  participantIgId      String
  lastMessageAt        DateTime
  lastInboundAt        DateTime?
  lastOutboundAt       DateTime?
  state                ThreadState @default(open)
  waitingSince         DateTime? // set on open→waiting; drives the nudge clock (PRD §6.5)
  nudgeDismissedAt     DateTime?
  // Denormalized for inbox sorting without joins (ARCHITECTURE.md §3.2).
  topLabel             ClassificationLabel?
  estValueMaxMinor     BigInt?
  // Stamp estimates with their creation currency: region changes must never
  // reinterpret stored values as a different currency.
  estCurrencyCode      String?
  // A thread is absent from Revenue Inbox while it has any review-only item.
  hasPendingReview     Boolean     @default(false)

  // Sender context (read-only display cache, never a contact record): User
  // Profile API snapshot, refreshed lazily when stale.
  participantName          String?
  participantAvatarUrl     String?
  participantFollowerCount Int?
  participantVerified      Boolean?
  participantFollowsYou    Boolean?
  profileFetchedAt         DateTime?
  // Where the conversation started when Instagram says so: dm|story|reel|ad|link.
  source                   String?
  // Email threads only: the subject line. Null for DMs.
  subject                  String?
  // Coach pipeline stage, set by the creator or by a booking or payment that reports back.
  leadStage                LeadStage?
  leadStageAt              DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  igAccount IgAccount     @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  messages  Message[]
  drafts    Draft[]
  ledger    LedgerEntry[]
  deals     Deal[]
  leadEvents LeadEvent[]

  @@unique([igAccountId, igThreadId])
  @@index([orgId, state, estValueMaxMinor(sort: Desc)]) // Revenue Inbox default sort
  @@index([orgId, state, waitingSince]) // nudge scheduler scan
}

model Message {
  id          String           @id @default(cuid())
  orgId       String
  threadId    String
  igMessageId String           @unique // idempotency key for webhook replays
  direction   MessageDirection
  contentType ContentType      @default(text)
  text        String
  sentAt      DateTime
  raw         Json?

  // Provenance — outbound only (null for inbound; enforced by a SQL CHECK).
  origin             MessageOrigin?
  // Voice notes: downloaded bytes live in AudioAsset; transcript feeds classification.
  audioAssetId       String?        @unique
  transcript         String?
  transcriptLanguage String?
  mediaStatus        String? // pending|ready|unavailable|failed (SQL CHECK)
  durationMs         Int?

  createdAt DateTime @default(now())

  thread         Thread          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  classification Classification?
  sentFromDraft  Draft?          @relation("SentAs")
  audioAsset     AudioAsset?     @relation(fields: [audioAssetId], references: [id], onDelete: SetNull)

  @@index([orgId, threadId, sentAt])
  @@index([orgId, direction, origin, sentAt]) // voice corpus scan (research 04 §3)
}

model Classification {
  id         String               @id @default(cuid())
  orgId      String
  messageId  String               @unique
  label      ClassificationLabel
  confidence Float
  language   MessageLanguage
  // Value estimate in org currency minor units (commerce labels only).
  valueMinMinor BigInt?
  valueMaxMinor BigInt?
  currencyCode String
  // One-line model explanation (DESIGN.md principle 9).
  rationale     String?
  modelVersion  String
  promptVersion String
  routedTo      RoutedTo
  source        ClassificationSource @default(live)

  reviewedBySeatId String?
  reviewOutcome    ReviewOutcome?
  overrideLabel    ClassificationLabel?
  reviewedAt       DateTime?

  createdAt DateTime @default(now())

  message    Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  reviewedBy Seat?   @relation("ReviewedBy", fields: [reviewedBySeatId], references: [id])

  @@index([orgId, routedTo, createdAt]) // review queue scan
  @@index([orgId, modelVersion]) // accuracy per model/prompt version
}

// ── Drafts & sends ───────────────────────────────────────────────────────

model Draft {
  id           String      @id @default(cuid())
  orgId        String
  threadId     String
  replyToMessageId String?
  kind         DraftKind   @default(reply)
  body         String
  version      Int         @default(1)
  status       DraftStatus @default(ready)
  modelVersion String
  promptVersion String

  // Set at send time by the API-layer send gate (ARCHITECTURE.md §6.2).
  sentAt         DateTime?
  sentBySeatId   String?
  sentMessageId  String?   @unique
  finalText      String?
  editDistance   Int?

  // Drafts that learn (research 04 §3).
  label             ClassificationLabel? // label drafted for (thread.topLabel drifts later)
  editRatio         Float?    // editDistance / body length, clamped 0..1, set at send
  instruction       String?   // regenerate-with-instruction text
  chips             String[]  @default([]) // DraftChip values applied to this generation
  alternatives      String[]  @default([]) // up to 3 variants on ONE row (one-live-draft invariant)
  chosenAlternative Int?      // index into alternatives
  generationContext Json?     // {ruleIds[], exemplarMessageIds[], lessonDraftIds[], lintViolations, promptVersion}
  editSignals       Json?     // deterministic detector output at learn time
  learnedAt         DateTime? // idempotency marker for the learning sweep
  // An invoice cover note: the approved send attaches this invoice's PDF.
  invoiceId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread      Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sentBy      Seat?    @relation("SentBy", fields: [sentBySeatId], references: [id])
  sentMessage Message? @relation("SentAs", fields: [sentMessageId], references: [id])
  sendIntent  SendIntent?
  feedback    DraftFeedback[]
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([orgId, threadId, status])
  @@index([orgId, status, sentAt]) // voice-fidelity trend scan
}

// ── Revenue Ledger (the product's soul) ──────────────────────────────────

model LedgerEntry {
  id       String   @id @default(cuid())
  orgId    String
  threadId String? // null for a deal's payment recorded outside DealDock
  dealType DealType
  amountMinor  BigInt
  // Denormalized at write time — org currency changes never rewrite history (ADR-9).
  currencyCode String
  idempotencyKey String
  note     String?
  closedAt DateTime @default(now())
  createdBySeatId String?
  deletedAt DateTime? // soft delete for refunds (PRD §6.7)
  // Set when the money comes from recording a deal's payment. A deal can have
  // several (an advance and a balance), one per invoice.
  dealId   String?
  invoiceId String? @unique
  // The creator account the money counts for (an email inbox's owner, never
  // the inbox) and who paid, stored so an entry needs no conversation.
  igAccountId        String
  counterpartyHandle String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A close-out must not prevent the owning account/org's privacy deletion.
  // Seat attribution is retained while the seat exists, but removing a seat
  // (or hard-deleting an org) must not leave a restrictive foreign-key edge.
  thread    Thread? @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdBy Seat?  @relation(fields: [createdBySeatId], references: [id], onDelete: SetNull)
  deal      Deal?  @relation(fields: [dealId], references: [id], onDelete: SetNull)
  invoice   Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // Deletion reaches an entry without a conversation through its account.
  igAccount IgAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@index([orgId, closedAt]) // monthly rollups
  @@unique([orgId, idempotencyKey])
  @@index([dealId])
  @@index([orgId, igAccountId, closedAt]) // per-creator totals (Roster, creator-scoped Revenue)
}

// ── Deals: one agreement carried from the conversation to the money ──────

model Deal {
  id       String    @id @default(cuid())
  orgId    String
  threadId String? // null for a deal agreed outside DealDock (a call, WhatsApp, in person)
  title    String
  dealType DealType
  // Agreed fee in org-currency minor units, currency frozen at write time (ADR-9).
  amountMinor  BigInt
  currencyCode String
  stage    DealStage @default(agreed)
  // DealTerms (@dealdock/core): deliverables, usage, exclusivity, revisions, advance, payment days, notes.
  terms    Json
  agreedAt   DateTime  @default(now())
  dueAt      DateTime? // when payment is due
  invoicedAt DateTime? // when payment was requested
  paidAt     DateTime?
  receivedMinor BigInt? // what actually arrived
  tdsMinor      BigInt? // tax the payer withheld (India TDS)
  // The creator dealt with the usage-rights expiry reminder (renewed, stopped or dismissed it).
  usageHandledAt   DateTime?
  // The creator pitched this brand again, or dismissed the renewal prompt.
  renewalHandledAt DateTime?
  idempotencyKey  String
  createdBySeatId String?
  deletedAt DateTime?
  // The creator account (an email inbox's owner, never the inbox) and who the
  // deal is with, stored so a deal needs no conversation.
  igAccountId        String
  counterpartyHandle String
  counterpartyName   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  thread      Thread?      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  createdBy   Seat?        @relation(fields: [createdBySeatId], references: [id], onDelete: SetNull)
  ledgerEntries LedgerEntry[]
  invoices    Invoice[]
  // Deletion reaches a deal without a conversation (and its invoices) through its account.
  igAccount   IgAccount    @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@unique([orgId, idempotencyKey])
  @@index([orgId, stage, dueAt]) // money owed, soonest first
  @@index([orgId, threadId])
  @@index([orgId, igAccountId]) // one creator's deals (Roster)
}

// ── Invoices: a correct PDF from a deal, paid one invoice at a time ──────

/**
 * The legal identity printed on invoices: one per workspace, plus a creator
 * account's own on Roster. `tax` and `payment` are validated at the API
 * boundary (BillingProfileInputSchema in @dealdock/core).
 */
model BillingProfile {
  id           String   @id @default(cuid())
  orgId        String
  // Null = the workspace profile; one per org (partial unique index in SQL,
  // since PostgreSQL treats NULLs as distinct).
  igAccountId  String?  @unique
  legalName    String
  addressLines String[] @default([])
  city         String?
  state        String? // India: GST state code ("27"), the supplier's place for place of supply
  country      String  // ISO 3166-1 alpha-2
  email        String?
  phone        String?
  tax          Json    // TaxRegistration: { kind, number, ratePercent, lutArn }
  pan          String?
  udyamNumber  String?
  sacCode      String?
  payment      Json    // PaymentDetails: UPI, bank, payment link
  invoicePrefix String @default("INV")
  // The (financial) year nextNumber counts in; a new year starts again at 1.
  numberYear   String?
  nextNumber   Int      @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  igAccount IgAccount?   @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

/**
 * One invoice for (part of) a deal. Everything it prints is frozen at issue
 * (supplier, billTo, lines, taxes), so a later profile edit never changes it
 * and its PDF renders the same bytes every time.
 */
model Invoice {
  id       String        @id @default(cuid())
  orgId    String
  dealId   String
  kind     InvoiceKind
  number   String
  issuedAt DateTime      @default(now())
  dueAt    DateTime
  // The deal's currency, frozen at write time (ADR-9).
  currencyCode  String
  supplier Json // InvoiceSupplier: the billing profile as issued, with its time zone and locale
  billTo   Json // InvoiceParty: name, address, country, state, GSTIN or VAT number
  lines    Json // InvoiceLine[]
  taxes    Json // InvoiceTaxLine[]; subtotal + tax = total exactly (SQL CHECK)
  subtotalMinor BigInt
  taxMinor      BigInt
  totalMinor    BigInt
  supplyType    SupplyType
  placeOfSupply String? // India: GST state code, "96" for exports
  notes    String?
  status   InvoiceStatus @default(issued)
  paidAt   DateTime?
  receivedMinor BigInt? // what actually arrived
  tdsMinor      BigInt? // tax the payer withheld (India TDS)
  voidedAt DateTime?
  createdBySeatId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal        Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy   Seat?        @relation(fields: [createdBySeatId], references: [id], onDelete: SetNull)
  ledgerEntry LedgerEntry?
  drafts      Draft[]

  @@unique([orgId, number])
  @@index([orgId, dealId])
}

// ── Voice, ignore list, audit ────────────────────────────────────────────

model VoiceProfile {
  id          String  @id @default(cuid())
  orgId       String
  igAccountId String  @unique
  // Sent-DM sampling is opt-in. A profile can exist before consent, but must
  // never be used for drafting until consentedAt is present.
  enabled     Boolean @default(false)
  consentedAt DateTime?
  revokedAt   DateTime?
  styleCard   Json?
  sampleMessageIds String[]
  version     Int     @default(1)
  refreshedAt DateTime?

  // Learning controls (Voice Studio).
  excludedMessageIds String[]  @default([]) // corpus messages the creator marked "not me"
  learningPaused     Boolean   @default(false) // drafts still use rules; no new learning
  lastDistilledAt    DateTime?
  styleOverrides     Json?     // Partial<StyleCard> the creator edited by hand

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  igAccount IgAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
}

/**
 * A learned or authored writing-style rule for one account. Deleted with the
 * account/org; voice-consent revocation must also delete these (voice.ts).
 */
model VoiceRule {
  id              String          @id @default(cuid())
  orgId           String
  igAccountId     String
  key             String          // dedupe key, e.g. "greeting", "avoid:thanks for reaching out"
  text            String          // creator-facing imperative
  scope           String          @default("all") // "all" | "nudge" | ClassificationLabel
  status          VoiceRuleStatus @default(candidate)
  source          VoiceRuleSource
  evidence        Float           @default(0) // decayed supporting evidence
  against         Float           @default(0) // decayed contradicting evidence
  distinctDrafts  Int             @default(0)
  distinctThreads Int             @default(0)
  creatorEvidence Float           @default(0) // evidence from creator-role seats only
  examples        Json            @default("[]") // ≤3 [{before, after}] snippets for the UI
  lastEvidenceAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  igAccount IgAccount    @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@unique([igAccountId, key, scope])
  @@index([orgId, igAccountId, status])
}

/** Quick feedback chips / note on a draft (no regeneration implied). */
model DraftFeedback {
  id        String   @id @default(cuid())
  orgId     String
  draftId   String
  seatId    String?
  chips     String[] @default([])
  note      String?

  createdAt DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  draft Draft        @relation(fields: [draftId], references: [id], onDelete: Cascade)
  seat  Seat?        @relation(fields: [seatId], references: [id], onDelete: SetNull)

  @@index([orgId, draftId])
}

// ── Offers & rate card (private draft context, never a public page) ──────

model Offer {
  id            String   @id @default(cuid())
  orgId         String
  // Null = applies to every account in the workspace.
  igAccountId   String?
  name          String
  dealType      DealType
  // Org-currency minor units; CHECKs keep them non-negative and ordered.
  priceMinMinor BigInt?
  priceMaxMinor BigInt?
  currencyCode  String
  link          String?
  details       String?
  availability  String?
  // Brand offers: OfferAddOns (@dealdock/core), add-on prices in org-currency minor units, validated at the API.
  addOns        Json?
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  igAccount IgAccount?   @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@index([orgId, active])
}

// ── Speaking voice (cloned TTS) & audio storage ──────────────────────────

/** One consented cloned speaking voice per account. Revoke deletes the provider voice + assets. */
model SpeakingVoice {
  id                String              @id @default(cuid())
  orgId             String
  igAccountId       String              @unique
  provider          String // "elevenlabs" | "selfhosted" | "mock"
  externalVoiceId   String?
  status            SpeakingVoiceStatus @default(pending)
  consentStatement  String
  consentedAt       DateTime
  consentSeatId     String?
  disclosureEnabled Boolean             @default(true)
  sampleSeconds     Float               @default(0)
  sampleAssetIds    String[]            @default([])
  lastError         String?
  revokedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  igAccount   IgAccount    @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
  consentSeat Seat?        @relation("SpeakingVoiceConsent", fields: [consentSeatId], references: [id], onDelete: SetNull)
}

/**
 * Audio bytes in Postgres (pilot scale; move to object storage past a few GB).
 * Never included in JSON exports. Rows past expiresAt are purged by the
 * retention job (purgeExpiredAudioAssets).
 */
model AudioAsset {
  id         String         @id @default(cuid())
  orgId      String
  kind       AudioAssetKind
  mimeType   String
  bytes      Bytes
  sizeBytes  Int // ≤ 25 MB (SQL CHECK)
  durationMs Int?
  text       String? // TTS source text or transcript snapshot
  sha256     String

  createdAt DateTime  @default(now())
  expiresAt DateTime?

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  message Message?

  @@index([orgId, kind, createdAt])
  @@index([expiresAt])
}

model IgnoreListEntry {
  id     String @id @default(cuid())
  orgId  String
  // Null preserves an org-wide legacy rule. Roster rules can be creator scoped.
  igAccountId String?
  handle String
  reason String?

  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  igAccount IgAccount? @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  // PostgreSQL treats NULLs as distinct in a normal compound unique index;
  // migration SQL supplies two partial unique indexes so legacy org-wide
  // rules cannot be duplicated while account rules stay independently scoped.
  @@index([orgId, igAccountId, handle])
}

model AuditLog {
  id         String @id @default(cuid())
  orgId      String
  seatId     String?
  action     String // e.g. "message.sent", "ledger.created", "settings.region_changed"
  entityType String
  entityId   String
  detail     Json? // for sends: original draft, final text, edit distance (PRD §7.5)

  createdAt DateTime @default(now())

  org  Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  seat Seat?        @relation(fields: [seatId], references: [id])

  @@index([orgId, createdAt])
}

// ── Billing (dual-rail, ADR-4) ───────────────────────────────────────────

model Subscription {
  id    String @id @default(cuid())
  orgId String @unique
  rail  BillingRail
  externalId String? @unique // razorpaySubscriptionId | paddleSubscriptionId
  // Hosted mandate/checkout page the creator opens once the 7-day gate fires.
  checkoutUrl String?
  tier  Tier
  status SubscriptionStatus @default(pending_first_invoice)
  activeUseStartedAt DateTime?
  firstInvoiceRequestedAt DateTime?
  currentPeriodEnd   DateTime?
  cancelledAt        DateTime?
  lastEventAt        DateTime?
  lastEventId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model BillingEventReceipt {
  rail BillingRail
  eventId String
  orgId String
  occurredAt DateTime?
  createdAt DateTime @default(now())
  org Organization @relation(fields:[orgId], references:[id], onDelete:Cascade)
  @@id([rail,eventId])
  @@index([orgId])
}

// ── Ingestion self-healing & notifications ───────────────────────────────

model IngestionCheckpoint {
  id          String   @id @default(cuid())
  orgId       String
  igAccountId String   @unique
  lastWebhookAt          DateTime?
  lastBackfillAt         DateTime?
  lastIgMessageTimestamp DateTime?
  // Provider sync cursor (Gmail historyId). Null until the first full sync.
  syncCursor             String?

  updatedAt DateTime @updatedAt

  igAccount IgAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)
}

model PushSubscription {
  id     String @id @default(cuid())
  orgId  String
  seatId String
  endpoint String @unique
  p256dh   String
  auth     String
  // Individually toggleable notification types (PRD §6.8).
  notifyHighValue     Boolean @default(true)
  notifyNudge         Boolean @default(true)
  notifyWeeklySummary Boolean @default(true)

  createdAt DateTime @default(now())

  seat Seat @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([orgId, seatId])
}

// ── Raw webhook audit/replay ─────────────────────────────────────────────

model WebhookEvent {
  id        String   @id @default(cuid())
  provider  String // "instagram" | "razorpay" | "paddle" | "mock"
  payload   Json
  processedAt DateTime?
  error     String?

  createdAt DateTime @default(now())

  orgScopes   WebhookEventOrg[]
  outboxEvents OutboxEvent[]

  @@index([provider, createdAt])
}

/** A webhook can carry entries for several connected accounts/orgs. */
model WebhookEventOrg {
  webhookEventId String
  orgId          String

  webhookEvent WebhookEvent @relation(fields: [webhookEventId], references: [id], onDelete: Cascade)
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@id([webhookEventId, orgId])
  @@index([orgId])
}

/**
 * Transactional ingress outbox. A worker leases and replays rows after Redis,
 * process, or deploy failure; webhook acknowledgement is never the only DM
 * record.
 */
model OutboxEvent {
  id             String   @id @default(cuid())
  orgId          String
  webhookEventId String?
  kind           String
  dedupeKey      String   @unique
  payload        Json
  attempts       Int      @default(0)
  leasedAt       DateTime?
  leaseExpiresAt DateTime?
  processedAt    DateTime?
  lastError      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  webhookEvent WebhookEvent? @relation(fields: [webhookEventId], references: [id], onDelete: SetNull)

  @@index([kind, processedAt, leaseExpiresAt])
  @@index([orgId, createdAt])
}

/**
 * A durable human approval. This makes an unknown remote-send outcome a
 * reconcile operation, never permission to send the same draft twice.
 */
model SendIntent {
  id                String           @id @default(cuid())
  orgId             String
  draftId           String           @unique
  seatId            String
  idempotencyKey    String
  finalText         String
  status            SendIntentStatus @default(pending)
  platformMessageId String?
  platformSentAt    DateTime?
  lastError         String?
  // Voice-note send: the human approved sending finalText as cloned audio.
  audioAssetId      String?
  asVoice           Boolean          @default(false)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  draft Draft @relation(fields: [draftId], references: [id], onDelete: Cascade)

  @@unique([orgId, idempotencyKey])
  @@index([orgId, status])
}

// ── Coach pipeline: booking and payment links that report back ───────────

/** A booking or payment tool's webhook into one workspace. */
model LeadSource {
  id        String             @id @default(cuid())
  orgId     String
  provider  LeadSourceProvider
  label     String?
  // SHA-256 of the secret segment in the webhook URL (/webhooks/leads/<token>); the token itself is shown once.
  tokenHash String             @unique
  // The provider's signing secret, AES-256-GCM like account tokens. Null for "other", which the URL token alone authenticates.
  secretEnc String?
  lastEventAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  events LeadEvent[]

  @@index([orgId])
}

/** A booking or payment a source reported. It moves its conversation's stage; a payment suggests recording the sale. */
model LeadEvent {
  id           String        @id @default(cuid())
  orgId        String
  sourceId     String
  // The provider's id for the booking or payment: a redelivery is ignored.
  externalId   String
  kind         LeadEventKind
  // The matched conversation; null until matched.
  threadId     String?
  // Payments only, in minor units of their own currency.
  amountMinor  BigInt?
  currencyCode String?
  payerName    String?
  occurredAt   DateTime
  // The creator recorded the sale from this payment, or dismissed it.
  handledAt    DateTime?

  createdAt DateTime @default(now())

  source LeadSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  thread Thread?    @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@unique([sourceId, externalId])
  @@index([orgId, threadId])
  @@index([orgId, handledAt])
}

// ── Comment leads: keyword comments answered by an approved private reply ──

model CommentLead {
  id              String            @id @default(cuid())
  orgId           String
  igAccountId     String
  // Instagram's comment id: the private reply is addressed to it, once.
  commentId       String
  mediaId         String
  // The post's permalink, when Instagram gives it.
  mediaUrl        String?
  commenterIgId   String
  commenterHandle String
  text            String
  keyword         String
  commentedAt     DateTime
  status          CommentLeadStatus @default(new)
  draftBody       String?
  modelVersion    String?
  sentAt          DateTime?
  sentBySeatId    String?
  // Facts the draft needed but the offers don't give ("your price"), shown before the one reply goes.
  missingFacts    String[]          @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  igAccount IgAccount @relation(fields: [igAccountId], references: [id], onDelete: Cascade)

  @@unique([igAccountId, commentId])
  @@index([orgId, status, commentedAt])
}
